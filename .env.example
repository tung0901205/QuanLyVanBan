# Copy this file to .env before starting Docker Compose.
# Use strong, unique values outside a local demo environment.
DB_PASSWORD=change-this-database-password
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters

# Gemini is optional. When empty, the AI service uses deterministic local fallbacks.
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_CONNECT_TIMEOUT_MS=3000
GEMINI_READ_TIMEOUT_MS=12000
GEMINI_MAX_CONCURRENT_REQUESTS=1
GEMINI_MAX_RETRIES=1

# Upload capacity (increase only when Docker has enough free disk space).
MAX_UPLOAD_FILE_SIZE=100MB
MAX_UPLOAD_REQUEST_SIZE=110MB
MAX_UPLOAD_FILE_SIZE_BYTES=104857600

# Optional Microsoft 365 integration.
OFFICE365_TENANT_ID=
OFFICE365_CLIENT_ID=
OFFICE365_CLIENT_SECRET=
SHAREPOINT_ENABLED=false
SHAREPOINT_SITE_ID=
SHAREPOINT_UPLOAD_PATH=eOIS/VanBan
